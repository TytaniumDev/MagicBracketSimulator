# Local mode overrides — copy to api/.env.local to switch to local mode
# Usage: npm run mode:local (from project root)
#
# .env.local takes precedence over .env — only the variables below are
# overridden; everything else in .env still applies.

# Disable GCP mode → SQLite + local filesystem (empty = LOCAL)
GOOGLE_CLOUD_PROJECT=

# Signs access-request approval links and authenticates internal calls
# (Cloud Tasks, Cloud Scheduler)
WORKER_SECRET=local-dev-secret
