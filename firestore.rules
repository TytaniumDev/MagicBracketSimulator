rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Clients only read, and only approved users: their users/{uid} access
    // record says 'allowed' (admins and ALLOWED_EMAILS accounts get one from
    // GET /api/me). Decks carry owner emails, so nothing is readable signed
    // out. Every write (jobs, simulations, decks, users) goes through the
    // API with the Admin SDK, which bypasses these rules. Worker presence
    // lives in the Realtime Database (database.rules.json).
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'allowed';
    }

    // Jobs and their per-simulation tracking.
    match /jobs/{jobId} {
      allow read: if isApproved();
      allow write: if false;

      match /simulations/{simId} {
        allow read: if isApproved();
        allow write: if false;
      }
    }

    // Pod runs (the pod run page listens for standings changes).
    match /podRuns/{runId} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /decks/{deckId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // Allow `collectionGroup('simulations')` reads for the desktop worker's
    // PENDING listener. Firestore looks up rules by the top-level path for
    // collection-group queries, so the nested match above doesn't apply.
    match /{path=**}/simulations/{simId} {
      allow read: if isApproved();
    }

    // Catch-all: deny everything else, including users/{uid} access records
    // (read only by the API and by the rule check above).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
