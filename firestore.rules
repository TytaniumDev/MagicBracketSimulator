rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Clients only read. Every write (jobs, simulations, decks, workers,
    // users) goes through the API with the Admin SDK, which bypasses these
    // rules. Worker presence lives in the Realtime Database
    // (database.rules.json).

    // Jobs and their per-simulation tracking: public reads.
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false;

      match /simulations/{simId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Pod runs: public reads (the pod run page listens for standings
    // changes).
    match /podRuns/{runId} {
      allow read: if true;
      allow write: if false;
    }

    // Decks: public reads.
    match /decks/{deckId} {
      allow read: if true;
      allow write: if false;
    }

    // Workers: public reads (durable worker settings; online status is
    // Realtime Database presence).
    match /workers/{workerId} {
      allow read: if true;
      allow write: if false;
    }

    // Allow `collectionGroup('simulations')` reads for the desktop worker's
    // PENDING listener. Firestore looks up rules by the top-level path for
    // collection-group queries, so the nested match above doesn't apply.
    match /{path=**}/simulations/{simId} {
      allow read: if true;
    }

    // Catch-all: deny everything else, including users/{uid} access records
    // (read only by the API).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
